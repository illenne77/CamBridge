<UserControl x:Class="CamBridge.App.Views.InspectionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CamBridge.App.ViewModels"
             xmlns:insp="clr-namespace:CamBridge.Inspection;assembly=CamBridge.Inspection"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InspectionViewModel}"
             d:DesignWidth="300" d:DesignHeight="700">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,8,2" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Margin" Value="0,0,4,4" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="6">
            <!-- Latest verdict and counters -->
            <Border Padding="8,4" CornerRadius="3">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#EEE" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LastVerdict}" Value="{x:Static insp:Verdict.Ok}">
                                <Setter Property="Background" Value="#2ECC40" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LastVerdict}" Value="{x:Static insp:Verdict.Ng}">
                                <Setter Property="Background" Value="#FF4136" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding LastResultText}" VerticalAlignment="Center" />
                    <TextBlock FontSize="22" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="—" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LastVerdict}" Value="{x:Static insp:Verdict.Ok}">
                                        <Setter Property="Text" Value="OK" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LastVerdict}" Value="{x:Static insp:Verdict.Ng}">
                                        <Setter Property="Text" Value="NG" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Border>

            <DockPanel Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Content="초기화" Command="{Binding ResetCountersCommand}" Margin="0" />
                <TextBlock VerticalAlignment="Center">
                    <Run Text="OK" Foreground="ForestGreen" FontWeight="SemiBold" /> <Run Text="{Binding OkCount, Mode=OneWay}" />
                    <Run Text="   NG" Foreground="Firebrick" FontWeight="SemiBold" /> <Run Text="{Binding NgCount, Mode=OneWay}" />
                    <Run Text="   양품률" /> <Run Text="{Binding YieldText, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
            <TextBlock Text="{Binding ReasonsText}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,4,0,0" />

            <!-- Recipe -->
            <TextBlock Text="레시피" Style="{StaticResource SectionHeader}" />
            <TextBox Text="{Binding RecipeName, UpdateSourceTrigger=LostFocus}" />
            <TextBlock Text="{Binding RecipePath}" Foreground="Gray" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding RecipePath}" />
            <WrapPanel Margin="0,4,0,0">
                <Button Content="불러오기" Command="{Binding LoadRecipeCommand}" />
                <Button Content="저장" Command="{Binding SaveRecipeCommand}" />
                <Button Content="다른 이름으로" Command="{Binding SaveRecipeAsCommand}" />
            </WrapPanel>

            <!-- Tools -->
            <DockPanel Margin="0,10,0,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="+ Blob" Command="{Binding AddBlobToolCommand}" />
                    <Button Content="삭제" Command="{Binding RemoveToolCommand}" Margin="0,0,0,4" />
                </StackPanel>
                <TextBlock Text="검사 도구" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <ListBox ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedTool}" MinHeight="60" MaxHeight="140">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ToolViewModel}">
                        <DockPanel>
                            <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding RoiText}" Foreground="Gray" Margin="8,0,0,0" />
                            <TextBlock>
                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /> <Run Text="{Binding Kind, Mode=OneWay}" Foreground="Gray" />
                            </TextBlock>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                       Text="라이브뷰의 [ROI 편집]: ROI 클릭으로 선택, 드래그로 이동·크기 조절, 빈 곳 드래그로 선택한 도구의 ROI를 새로 그립니다." />

            <!-- Selected tool settings -->
            <ContentControl Content="{Binding SelectedTool}" Margin="0,6,0,0">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type vm:ToolViewModel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}">
                                <Run Text="{Binding Name, Mode=OneWay}" /> <Run Text="설정" />
                            </TextBlock>

                            <!-- Blob -->
                            <Grid Visibility="{Binding IsBlob, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>

                                <TextBlock Text="이진화" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:ToolViewModel.ThresholdModes}" SelectedItem="{Binding ThresholdMode}" Margin="0,2,4,2" />
                                <TextBox Grid.Column="2" Text="{Binding Threshold, UpdateSourceTrigger=LostFocus}" ToolTip="임계값 0-255 (Fixed일 때)" />

                                <TextBlock Grid.Row="1" Text="극성" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{x:Static vm:ToolViewModel.Polarities}" SelectedItem="{Binding Polarity}" Margin="0,2" />

                                <TextBlock Grid.Row="2" Text="최소 면적" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding MinBlobArea, UpdateSourceTrigger=LostFocus}" ToolTip="이보다 작은 블롭은 노이즈로 무시 (px)" />

                                <TextBlock Grid.Row="3" Grid.Column="1" Text="최소" Foreground="Gray" FontSize="11" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="최대" Foreground="Gray" FontSize="11" />

                                <TextBlock Grid.Row="4" Text="개수" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CountMin, TargetNullValue='', UpdateSourceTrigger=LostFocus}" Margin="0,2,4,2" />
                                <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding CountMax, TargetNullValue='', UpdateSourceTrigger=LostFocus}" />

                                <TextBlock Grid.Row="5" Text="총 면적" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding TotalAreaMin, TargetNullValue='', UpdateSourceTrigger=LostFocus}" Margin="0,2,4,2" />
                                <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding TotalAreaMax, TargetNullValue='', UpdateSourceTrigger=LostFocus}" />

                                <TextBlock Grid.Row="6" Text="최대 면적" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding MaxAreaMin, TargetNullValue='', UpdateSourceTrigger=LostFocus}" Margin="0,2,4,2" />
                                <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding MaxAreaMax, TargetNullValue='', UpdateSourceTrigger=LostFocus}" />

                                <TextBlock Grid.Row="7" Grid.ColumnSpan="3" Text="빈 칸은 제한 없음" Foreground="Gray" FontSize="11" />
                            </Grid>

                            <!-- Template match -->
                            <Grid Visibility="{Binding IsTemplate, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="최소 점수" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding MinScore, UpdateSourceTrigger=LostFocus}" ToolTip="정규화 상관계수 0-1" />
                                <TextBlock Grid.Row="1" Text="템플릿" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TemplatePath}" VerticalAlignment="Center" Foreground="DimGray" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <TextBlock Text="{Binding Message}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
