<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Basler pylon .NET API is referenced only when the SDK is installed, so the solution
    builds on machines (and CI) without pylon. SDK binaries are never committed.

    Override the assembly location with:
      dotnet build -p:PylonNetAssembly="<path>\Basler.Pylon.dll"

    Default verified against pylon 26.09.2 (2026-10-27): the net8.0 build of the .NET API ships as
    $(PYLON_DEV_DIR)\Assemblies\Basler.Pylon\net8.0\x64\Basler.Pylon.dll, the same path the
    SDK's own net8.0 samples reference.
  -->
  <PropertyGroup>
    <!--
      A shell or IDE started before pylon was installed does not inherit PYLON_DEV_DIR. Falling back to
      the persisted machine variable keeps every build on this PC consistent (with or without the SDK
      in one output folder, the app's deps.json goes stale). Build without the SDK on such a PC with
      -p:PylonNetAssembly=none.
    -->
    <PYLON_DEV_DIR Condition="'$(PYLON_DEV_DIR)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">$([MSBuild]::GetRegistryValue('HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Session Manager\Environment', 'PYLON_DEV_DIR'))</PYLON_DEV_DIR>
    <PylonNetAssembly Condition="'$(PylonNetAssembly)' == '' and '$(PYLON_DEV_DIR)' != ''">$([System.IO.Path]::Combine('$(PYLON_DEV_DIR)', 'Assemblies', 'Basler.Pylon', 'net8.0', 'x64', 'Basler.Pylon.dll'))</PylonNetAssembly>
    <HasPylon>false</HasPylon>
    <HasPylon Condition="'$(PylonNetAssembly)' != '' and Exists('$(PylonNetAssembly)')">true</HasPylon>
    <DefineConstants Condition="'$(HasPylon)' == 'true'">$(DefineConstants);HAS_PYLON</DefineConstants>
    <!-- The API assembly is x64-only; the SDK samples silence the AnyCPU mismatch (MSB3270) the same way. -->
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
  </PropertyGroup>

  <ItemGroup Condition="'$(HasPylon)' == 'true'">
    <Reference Include="Basler.Pylon">
      <HintPath>$(PylonNetAssembly)</HintPath>
      <!--
        Copied to the (git-ignored) build output: .NET 8 has no GAC, so the managed API must sit
        next to the app. The native runtime (Runtime\x64) is found through PATH; see PylonRuntime.
      -->
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Managed API only (Bayer demosaicing). Native runtimes are referenced by executable projects. -->
    <PackageReference Include="OpenCvSharp4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CamBridge.Core\CamBridge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CamBridge.Tests.Windows" />
  </ItemGroup>

  <Target Name="ReportPylonAvailability" BeforeTargets="CoreCompile">
    <Message Importance="high" Condition="'$(HasPylon)' == 'true'" Text="CamBridge.Sources.Pylon: pylon SDK found at $(PylonNetAssembly)" />
    <Message Importance="high" Condition="'$(HasPylon)' != 'true'" Text="CamBridge.Sources.Pylon: pylon SDK not found, building without pylon support" />
  </Target>

</Project>
