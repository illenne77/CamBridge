<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for Windows-only projects. Not run by CI (Linux); run locally with
    dotnet test tests/CamBridge.Tests.Windows. Device tests skip when no webcam is connected.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="OpenCvSharp4.runtime.win" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\CamBridge.Tests\Fakes\TrackingArrayPool.cs" Link="Fakes\TrackingArrayPool.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CamBridge.Core\CamBridge.Core.csproj" />
    <ProjectReference Include="..\..\src\CamBridge.Sources.Webcam\CamBridge.Sources.Webcam.csproj" />
    <ProjectReference Include="..\..\src\CamBridge.App\CamBridge.App.csproj" />
  </ItemGroup>

</Project>
